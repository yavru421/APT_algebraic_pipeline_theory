# Normalize line endings
* text=auto

# Declare files that should always be LF on checkout
*.py text eol=lf
*.md  text eol=lf
*.sh  text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
