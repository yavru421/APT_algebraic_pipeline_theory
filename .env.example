# APT Enterprise MCP Server Configuration
# Copy to .env and customize for your environment

# API Configuration
API_TITLE="APT Enterprise MCP Server"
API_VERSION="2.0.0"
API_DESCRIPTION="Bleeding-edge AI pipeline server with enterprise features"

# Security (CHANGE IN PRODUCTION!)
SECRET_KEY="apt-super-secret-key-change-in-production-please"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs
LLAMA_API_URL="https://llama-universal-netlify-project.netlify.app/.netlify/functions/llama-proxy"
OPENAI_API_KEY=""  # Optional: Add your OpenAI API key

# Vector Database
VECTOR_DIMENSION=384
VECTOR_INDEX_PATH="./vector_index.faiss"

# Redis Configuration
REDIS_URL="redis://localhost:6379"
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_REQUESTS="100/minute"

# Observability
JAEGER_ENDPOINT="http://localhost:14268/api/traces"
LOG_LEVEL="INFO"

# Production Settings
ENVIRONMENT="development"  # development, staging, production
DEBUG=true
WORKERS=4