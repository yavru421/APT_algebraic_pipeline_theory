# RAPT Example: Theory Proof Pipeline
name: Theory Proof
modules:
  - id: m1
    type: latex_compile
    input: proof.tex
    output: proof.pdf
  - id: m2
    type: extract_equations
    input: proof.pdf
    output: equations.txt
  - id: m3
    type: visualize_equations
    input: equations.txt
    output: equations.png
