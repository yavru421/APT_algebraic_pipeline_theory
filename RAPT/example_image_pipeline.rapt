# RAPT Example: Image Processing Pipeline
name: Image Pipeline
modules:
  - id: m1
    type: base64_encode
    input: input_image.jpg
    output: encoded.txt
  - id: m2
    type: image_filter
    input: encoded.txt
    output: filtered.txt
  - id: m3
    type: build_payload
    input: filtered.txt
    output: payload.json
  - id: m4
    type: call_api
    input: payload.json
    output: api_response.json
